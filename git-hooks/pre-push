#!/usr/bin/env bash

# ============================================================================
# Git Pre-Push Validator (pre-push hook)
# ============================================================================
#
# Purpose: Performs repository-agnostic checks before pushing commits
# Usage:   Invoked automatically by Git as a pre-push hook
#
# NOTE: This hook can be bypassed with:
#       git push --no-verify
#
# IMPORTANT: This file must be executable!
#            Run: chmod +x <path-to-hook>/pre-push
#
# ============================================================================

# Configuration

# Block direct pushes to protected branches.
# Set to false to warn instead of reject.
BLOCK_PROTECTED_BRANCH_PUSHES=false
PROTECTED_BRANCHES=("main" "master")

# Author and committer email validation.
# Intentionally permissive: only reject obviously malformed addresses.
EMAIL_REGEX='^[^[:space:]@]+@[^[:space:]@]+$'

# Detect "WIP" as a standalone token, case-insensitively.
WIP_REGEX='(^|[^[:alnum:]_])[Ww][Ii][Pp]([^[:alnum:]_]|$)'

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helpers

# Function to print error messages
printError() {
    printf '%b%s\n' "${RED}[PUSH REJECTED]${NC} " "$1"
}

# Function to print success messages
printSuccess() {
    printf '%b%s\n' "${GREEN}[PUSH ACCEPTED]${NC} " "$1"
}

# Function to print warnings
printWarning() {
    printf '%b%s\n' "${YELLOW}[WARNING]${NC} " "$1"
}

# Check whether a branch is protected
isProtectedBranch() {
    local BRANCH="$1"
    local PROTECTED_BRANCH

    for PROTECTED_BRANCH in "${PROTECTED_BRANCHES[@]}"; do
        if [[ "$BRANCH" == "$PROTECTED_BRANCH" ]]; then
            return 0
        fi
    done

    return 1
}

# Collect commits introduced by a ref update
collectCommits() {
    local LOCAL_COMMIT="$1"
    local REMOTE_OID="$2"
    local REMOTE_COMMIT=""

    # If the remote ref already exists and its commit is available locally,
    # inspect only commits introduced relative to that remote commit.
    if [[ ! "$REMOTE_OID" =~ ^0+$ ]]; then
        REMOTE_COMMIT=$(git rev-parse --verify "${REMOTE_OID}^{commit}" 2>/dev/null || true)
    fi

    if [[ -n "$REMOTE_COMMIT" ]]; then
        git rev-list "${REMOTE_COMMIT}..${LOCAL_COMMIT}"
        return
    fi

    # For a new remote ref, exclude commits already reachable from
    # remote-tracking refs for the destination remote.
    if git remote get-url "$REMOTE_NAME" >/dev/null 2>&1; then
        git rev-list "$LOCAL_COMMIT" --not --remotes="$REMOTE_NAME"
        return
    fi

    # If pushing directly to a URL rather than a named remote, there may be no
    # remote-tracking refs available, so inspect the reachable commit history.
    git rev-list "$LOCAL_COMMIT"
}

# Validation

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

if [[ -z "$REMOTE_NAME" || -z "$REMOTE_URL" ]]; then
    printError "Remote name or URL was not provided by Git."
    exit 1
fi

COMMITS_FILE=$(mktemp) || {
    printError "Unable to create temporary file."
    exit 1
}

trap 'rm -f "$COMMITS_FILE"' EXIT

PROBLEM_FOUND=0

# Git provides one line per ref being pushed:
# <local-ref> <local-object-name> <remote-ref> <remote-object-name>
while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
    REMOTE_BRANCH=""

    if [[ "$REMOTE_REF" == refs/heads/* ]]; then
        REMOTE_BRANCH=${REMOTE_REF#refs/heads/}
    fi

    # A zero local object ID means the remote ref is being deleted
    if [[ "$LOCAL_OID" =~ ^0+$ ]]; then
        if [[ -n "$REMOTE_BRANCH" ]] && isProtectedBranch "$REMOTE_BRANCH"; then
            printError "Deletion of protected branch '$REMOTE_BRANCH' is not allowed."
            PROBLEM_FOUND=1
        fi

        continue
    fi

    # Resolve the local ref to a commit
    LOCAL_COMMIT=$(git rev-parse --verify "${LOCAL_OID}^{commit}" 2>/dev/null || true)

    # Skip refs that do not ultimately point to a commit
    if [[ -z "$LOCAL_COMMIT" ]]; then
        continue
    fi

    if [[ -n "$REMOTE_BRANCH" ]] && isProtectedBranch "$REMOTE_BRANCH"; then
        # Reject non-fast-forward updates to protected branches
        if [[ ! "$REMOTE_OID" =~ ^0+$ ]]; then
            REMOTE_COMMIT=$(git rev-parse --verify "${REMOTE_OID}^{commit}" 2>/dev/null || true)

            if [[ -z "$REMOTE_COMMIT" ]]; then
                printWarning "Unable to verify fast-forward status for '$REMOTE_BRANCH'."
            elif ! git merge-base --is-ancestor "$REMOTE_COMMIT" "$LOCAL_COMMIT"; then
                printError "Non-fast-forward update detected for '$REMOTE_BRANCH'."
                PROBLEM_FOUND=1
            fi
        fi

        # Warn or reject direct pushes to protected branches
        if [[ "$BLOCK_PROTECTED_BRANCH_PUSHES" == true ]]; then
            printError "Direct push to protected branch '$REMOTE_BRANCH' is not allowed."
            PROBLEM_FOUND=1
        else
            printWarning "Direct push to protected branch '$REMOTE_BRANCH'."
        fi
    fi

    # Collect commits introduced by this ref update
    if ! collectCommits "$LOCAL_COMMIT" "$REMOTE_OID" >> "$COMMITS_FILE"; then
        printError "Unable to determine commits being pushed for '$REMOTE_REF'."
        PROBLEM_FOUND=1
    fi
done

# Avoid checking the same commit more than once when pushing overlapping refs
sort -u "$COMMITS_FILE" -o "$COMMITS_FILE"

while IFS= read -r COMMIT; do
    [[ -z "$COMMIT" ]] && continue

    SHORT_COMMIT=$(git rev-parse --short "$COMMIT")
    SUBJECT=$(git show -s --format=%s "$COMMIT")
    AUTHOR_EMAIL=$(git show -s --format=%ae "$COMMIT")
    COMMITTER_EMAIL=$(git show -s --format=%ce "$COMMIT")

    # Reject autosquash commits that should be cleaned up before pushing
    case "$SUBJECT" in
        "fixup! "*|"squash! "*|"amend! "*)
            printError "Autosquash commit detected: $SHORT_COMMIT $SUBJECT"
            PROBLEM_FOUND=1
            ;;
    esac

    # Reject commits marked as work in progress
    if [[ "$SUBJECT" =~ $WIP_REGEX ]]; then
        printError "WIP commit detected: $SHORT_COMMIT $SUBJECT"
        PROBLEM_FOUND=1
    fi

    # Reject obviously malformed author email addresses
    if [[ ! "$AUTHOR_EMAIL" =~ $EMAIL_REGEX ]]; then
        printError "Invalid author email in $SHORT_COMMIT: '$AUTHOR_EMAIL'"
        PROBLEM_FOUND=1
    fi

    # Reject obviously malformed committer email addresses
    if [[ ! "$COMMITTER_EMAIL" =~ $EMAIL_REGEX ]]; then
        printError "Invalid committer email in $SHORT_COMMIT: '$COMMITTER_EMAIL'"
        PROBLEM_FOUND=1
    fi
done < "$COMMITS_FILE"

if (( PROBLEM_FOUND != 0 )); then
    exit 1
fi

printSuccess "Pre-push checks passed."
exit 0
