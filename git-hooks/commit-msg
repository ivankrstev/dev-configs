#!/usr/bin/env bash

# ============================================================================
# Git Commit Message Validator (commit-msg hook)
# ============================================================================
#
# Purpose: Validates commit messages against a Conventional Commits-based policy
# Usage:   Invoked automatically by Git as a commit-msg hook
#
# IMPORTANT: This file must be executable!
#            Run: chmod +x <path-to-hook>/commit-msg
#
# For a global hooks directory:
#   git config --global core.hooksPath <path-to-hook>
# ============================================================================

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print error messages
printError() {
    printf '%b\n' "${RED}[COMMIT REJECTED]${NC} $1"
}

# Function to print success messages
printSuccess() {
    printf '%b\n' "${GREEN}[COMMIT ACCEPTED]${NC} $1"
}

# Function to print warnings
printWarning() {
    printf '%b\n' "${YELLOW}[WARNING]${NC} $1"
}

# Read the commit message file provided by Git
COMMIT_MSG_FILE="${1:-}"

if [[ -z "$COMMIT_MSG_FILE" || ! -f "$COMMIT_MSG_FILE" ]]; then
    printError "Commit message file not found!"
    exit 1
fi

# Read the commit subject
IFS= read -r FIRST_LINE < "$COMMIT_MSG_FILE"

if [[ -z "$FIRST_LINE" ]]; then
    printError "Commit message cannot be empty!"
    exit 1
fi

# Bypass Git-generated commit messages
case "$FIRST_LINE" in
    "Merge "*)
        printSuccess "Bypass: merge commit detected."
        exit 0
        ;;
    "Revert "*)
        printSuccess "Bypass: revert commit detected."
        exit 0
        ;;
    "fixup! "*|"squash! "*|"amend! "*)
        printSuccess "Bypass: autosquash commit detected."
        exit 0
        ;;
esac

# Define allowed commit types
VALID_TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security|deps'

# Conventional Commit format:
#   type(scope)!: description
#
# - type:        Required; must be one of the allowed types
# - scope:       Optional; wrapped in parentheses
# - !:           Optional; indicates a breaking change
# - description: Required; preceded by ": ", with a non-whitespace first character
CONVENTIONAL_COMMIT_REGEX="^(${VALID_TYPES})(\([a-zA-Z0-9._/-]+\))?!?: [^[:space:]].*$"

if [[ ! "$FIRST_LINE" =~ $CONVENTIONAL_COMMIT_REGEX ]]; then
    printError "Commit message does not follow the required Conventional Commits format."
    printf '%s\n' \
        "Expected: <type>(optional-scope)!: <description>" \
        "Valid types: $VALID_TYPES" \
        "" \
        "Examples:" \
        "  feat(auth): add login functionality" \
        "  fix: resolve null pointer exception" \
        "  feat(api)!: remove deprecated endpoint"
    exit 1
fi

FIRST_LINE_LENGTH=${#FIRST_LINE}

if (( FIRST_LINE_LENGTH > 72 )); then
    printError "Subject is ${FIRST_LINE_LENGTH} characters (max 72)."
    exit 1
elif (( FIRST_LINE_LENGTH > 50 )); then
    printWarning "Subject is ${FIRST_LINE_LENGTH} characters (recommended ≤50)."
fi

# Warn if the description starts with an uppercase letter (style preference)
LOWERCASE_REGEX="^(${VALID_TYPES})(\([a-zA-Z0-9._/-]+\))?!?: [A-Z]"
if [[ "$FIRST_LINE" =~ $LOWERCASE_REGEX ]]; then
    printWarning "Description should start with a lowercase letter."
fi

# Enforce style rule: subject should not end with a period
if [[ "$FIRST_LINE" == *. ]]; then
    printError "Subject should not end with a period."
    exit 1
fi

# Warn if the commit body is not separated from the subject by a blank line
SECOND_LINE=$(sed -n '2p' "$COMMIT_MSG_FILE")
if [[ -n "$SECOND_LINE" ]]; then
    printWarning "Second line should be blank to separate subject from body."
fi

exit 0
